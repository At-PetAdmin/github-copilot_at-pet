{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node \"__ATPET_BRIDGE__/bridge.mjs\" sessionStart",
        "powershell": "node \"__ATPET_BRIDGE__\\bridge.mjs\" sessionStart",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "node \"__ATPET_BRIDGE__/bridge.mjs\" userPromptSubmitted",
        "powershell": "node \"__ATPET_BRIDGE__\\bridge.mjs\" userPromptSubmitted",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "node \"__ATPET_BRIDGE__/bridge.mjs\" preToolUse",
        "powershell": "node \"__ATPET_BRIDGE__\\bridge.mjs\" preToolUse",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "node \"__ATPET_BRIDGE__/bridge.mjs\" postToolUse",
        "powershell": "node \"__ATPET_BRIDGE__\\bridge.mjs\" postToolUse",
        "timeoutSec": 10
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "node \"__ATPET_BRIDGE__/bridge.mjs\" errorOccurred",
        "powershell": "node \"__ATPET_BRIDGE__\\bridge.mjs\" errorOccurred",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "node \"__ATPET_BRIDGE__/bridge.mjs\" agentStop",
        "powershell": "node \"__ATPET_BRIDGE__\\bridge.mjs\" agentStop",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "node \"__ATPET_BRIDGE__/bridge.mjs\" sessionEnd",
        "powershell": "node \"__ATPET_BRIDGE__\\bridge.mjs\" sessionEnd",
        "timeoutSec": 10
      }
    ]
  }
}
